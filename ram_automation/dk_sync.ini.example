; Local config for DK_Sync.ahk. Copy to C:\FSBHOA\dk_sync.ini on the RAM PC.
; Keep this file on the PC's LOCAL disk, never on the NAS.
; Values must be bare (IniRead does not strip inline comments).
;
; Environment  : testbed | production. Selects the watch folder To_RAM_Testbed / To_RAM_Production
;                and must match env= in the trigger file.
; ExpectedHost : host name of the Access Control server allowed to trigger this PC
;                (testbed.fsbhoa.com or the production host). Must match host= in the trigger file.
; BaseDir      : NAS folder as mapped on this PC.
; GateRowsY    : comma-separated y-coordinates of the gate rows to select in RAM's
;                Action > Send Data Now dialog. Production: 122,142 (North Gates, South Gates).
;
; Optional, for the vehicle plugin's RAM Live Streaming (leave StreamStatusUrl out to turn it off):
; StreamStatusUrl : vehicle_service's /ram-status on the Access Control server, e.g.
;                   http://192.168.42.62:8088/ram-status (testbed). Empty means RAM isn't
;                   streaming to it; the script then restarts RAM, which reconnects.
; RamPath         : full path of DoorKing32.exe. Optional: the script notes it while RAM runs.
; StreamIdleSeconds : optional. Close RAM only when nobody has touched the keyboard or mouse
;                   for this many seconds (e.g. 120 on a PC someone works at). Default 0.

[DK_Sync]
Environment=testbed
ExpectedHost=testbed.fsbhoa.com
BaseDir=Y:\Automation\DoorKing
GateRowsY=122
;StreamStatusUrl=http://192.168.42.62:8088/ram-status
